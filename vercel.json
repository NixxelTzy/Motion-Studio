{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/admin",
      "dest": "/admin.html"
    },
    {
      "src": "/web",
      "dest": "/web.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}